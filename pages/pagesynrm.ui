     <layout class="QVBoxLayout" name="mtpaGroupLayout">
      <item>
       <widget class="QLabel" name="mtpaHelpLabel">
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="text">
         <string>&lt;b&gt;2-D trajectory (MTPA + field weakening):&lt;/b&gt; export LUT.xls to CSV (cols: current, speed, id, iq) → &lt;b&gt;Load&lt;/b&gt; below → set &lt;b&gt;foc_traj_vnorm&lt;/b&gt; to the table's bus voltage → Write Motor Config. Current/id taken as PEAK; needs MTPA = Trajectory 2-D + FW.</string>
        </property>
