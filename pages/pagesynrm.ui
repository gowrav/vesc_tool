          </property>
          <property name="toolTip">
           <string>Select a MotorXP _DQmodel_parameters folder (Id.csv, Iq.csv, Fluxlinkage_d.csv, Fluxlinkage_q.csv). The MTPA id*(|I|) locus is computed here and written into the SynRM MTPA lookup table. Then Write Motor Configuration to upload it.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="mtpaInfoLabel">
          <property name="text">
           <string>Current LUT: baked default (connected motor) — load a CSV to replace it.</string>
